rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function sameCompany(companyId) {
      return signedIn() && request.auth.token.companyId == companyId;
    }
    function dispatcher() {
      return signedIn() && request.auth.token.role in ['owner', 'manager', 'dispatcher', 'admin'];
    }
    function assignedDriver(tripId) {
      return signedIn()
        && get(/databases/$(database)/documents/trips/$(tripId)).data.driverUid == request.auth.uid
        && get(/databases/$(database)/documents/trips/$(tripId)).data.status == 'IN_PROGRESS'
        && get(/databases/$(database)/documents/trips/$(tripId)).data.companyId == request.auth.token.companyId;
    }

    match /trips/{tripId} {
      allow read: if signedIn() && sameCompany(resource.data.companyId)
        && (dispatcher() || resource.data.driverUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /liveLocations/{tripId} {
      allow read: if signedIn()
        && sameCompany(resource.data.companyId)
        && dispatcher();
      allow create, update: if assignedDriver(tripId)
        && request.resource.data.companyId == request.auth.token.companyId
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'companyId', 'driverUid', 'latitude', 'longitude',
          'accuracyMeters', 'updatedAt', 'active'
        ])
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.accuracyMeters is number
        && request.resource.data.accuracyMeters >= 0
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}